 	void Release();
 
 	void Run();
+	// XSnes3D+: see IsHostDriven.
+	bool _hostDriven = false;
 
 	// XSnes3D+: lets a host step the emulation itself, one frame per call, on the calling thread,
 	// with no emulation thread and no frame limiter wait. Call HostBegin once after
 	// LoadRom(file, patch, false), then HostRunFrame for each frame.
 	void HostBegin();
 	void HostRunFrame();
+	// XSnes3D+: true once HostBegin ran. The host reads the PPU's picture itself, so Mesen's own
+	// video decoder is skipped then (see VideoDecoder::UpdateFrame).
+	bool IsHostDriven() { return _hostDriven; }
 
 	void Stop(bool sendNotification, bool preventRecentGameSave = false, bool saveBattery = true);
 
