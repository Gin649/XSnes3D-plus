+// One Mode 7 line of background 1 or 2: the colour number of each pixel before windows,
+// priorities and colour maths, 0 where the layer is clear. For background 2 (EXTBG) bit 7 is
+// the pixel's priority. Matrix holds the line's Mode 7 matrix (A, B, C, D, 8.8 fixed point):
+// how far the picture moves per screen pixel, which tells how far away a floor's line is.
+struct SnesTapMode7Line
+{
+	uint16_t Scanline;
+	uint8_t Layer;
+	uint8_t Padding;
+	int16_t Matrix[4];
+	uint8_t Color[256];
+};
+static_assert(sizeof(SnesTapMode7Line) == 268, "SnesTapMode7Line layout changed");
