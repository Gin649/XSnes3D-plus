+// XSnes3D+: the tile tap. Records one drawn piece of the current line with the settings
+// used to draw it, and copies the main screen pixels before colour maths changes them.
+void SnesPpu::TapChunk()
+{
+	SnesTapChunk chunk = {};
+	chunk.Scanline = _scanline;
+	chunk.StartX = (uint8_t)_drawStartX;
+	chunk.EndX = (uint8_t)_drawEndX;
+	chunk.BgMode = _state.BgMode;
+	chunk.Bg3Priority = _state.Mode1Bg3Priority ? 1 : 0;
+	chunk.MainLayers = _state.MainScreenLayers & _configVisibleLayers;
+	chunk.DirectColor = _state.DirectColorMode ? 1 : 0;
+	chunk.ForcedBlank = _state.ForcedBlank ? 1 : 0;
+	chunk.MosaicSize = _state.MosaicSize;
+	chunk.MosaicEnabled = _state.MosaicEnabled;
+	for(int i = 0; i < 4; i++) {
+		chunk.HScroll[i] = _state.Layers[i].HScroll;
+	}
+
+	// A new palette snapshot only when the palette changed since the last one.
+	size_t count = _tap->Building.Cgram.size() / 256;
+	if(count == 0 || memcmp(&_tap->Building.Cgram[(count - 1) * 256], _cgram, 512) != 0) {
+		_tap->Building.Cgram.insert(_tap->Building.Cgram.end(), _cgram, _cgram + 256);
+		count++;
+	}
+	chunk.CgramIndex = (uint32_t)(count - 1);
+
+	TapWindowMask<0>(chunk.WindowMasked[0]);
+	TapWindowMask<1>(chunk.WindowMasked[1]);
+	TapWindowMask<2>(chunk.WindowMasked[2]);
+	TapWindowMask<3>(chunk.WindowMasked[3]);
+	TapWindowMask<SnesPpu::SpriteLayerIndex>(chunk.WindowMasked[4]);
+
+	_tap->Building.Chunks.push_back(chunk);
+	memcpy(_tapReference + _drawStartX, _mainScreenBuffer + _drawStartX, (_drawEndX - _drawStartX + 1) * sizeof(uint16_t));
+}
+
+// XSnes3D+: which pixels of this piece a window hides from the main screen, for one layer.
+template<uint8_t layerIndex>
+void SnesPpu::TapWindowMask(uint8_t masked[32])
+{
+	memset(masked, 0, 32);
+	if(!_state.WindowMaskMain[layerIndex]) {
+		return;
+	}
+	uint8_t count = (uint8_t)_state.Window[0].ActiveLayers[layerIndex] + (uint8_t)_state.Window[1].ActiveLayers[layerIndex];
+	for(int x = _drawStartX; x <= _drawEndX; x++) {
+		if(ProcessMaskWindow<layerIndex>(count, x)) {
+			masked[x >> 3] |= (uint8_t)(1 << (x & 0x07));
+		}
+	}
+}
+
+// XSnes3D+: the line is finished; keep its fetched tiles and its main screen.
+void SnesPpu::TapLineEnd()
+{
+	_tap->Building.Lines.emplace_back();
+	SnesTapLine& line = _tap->Building.Lines.back();
+	line.Scanline = _scanline;
+	line.Padding = 0;
+	for(int i = 0; i < 4; i++) {
+		memcpy(line.Tiles[i], _layerData[i].Tiles, sizeof(line.Tiles[i]));
+	}
+	memcpy(line.Reference, _tapReference, sizeof(line.Reference));
+	memset(_tapReference, 0, sizeof(_tapReference));
+}
+
+// XSnes3D+: one 8-pixel sprite slice, fetched now and drawn on the next line.
+void SnesPpu::TapSprite()
+{
+	SnesTapSprite sprite = {};
+	sprite.FetchScanline = _scanline;
+	sprite.X = _currentSprite.DrawX;
+	sprite.Palette = _currentSprite.Palette;
+	sprite.Priority = _currentSprite.Priority;
+	sprite.HorizontalMirror = _currentSprite.HorizontalMirror ? 1 : 0;
+	// The flip down is not kept in _currentSprite; it is bit 7 of the sprite's OAM attributes.
+	sprite.VerticalMirror = (_oamRam[(_currentSprite.Index << 2) + 3] & 0x80) ? 1 : 0;
+	sprite.ChrData[0] = _currentSprite.ChrData[0];
+	sprite.ChrData[1] = _currentSprite.ChrData[1];
+	sprite.VramAddress = (_currentSprite.FetchAddress - 8) & 0x7FFF;
+	_tap->Building.Sprites.push_back(sprite);
+}
