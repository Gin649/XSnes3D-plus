+// XSnes3D+: the host drives the frames (see Emulator.h). This sets up what Run() sets up
+// before its loop: the emulation thread is the caller's, and the frame limiter never waits.
+void Emulator::HostBegin()
+{
+	_stopFlag = false;
+	_isRunAheadFrame = false;
+	_emulationThreadId = std::this_thread::get_id();
+	_frameDelay = 0;
+	_stats.reset(new DebugStats());
+	_frameLimiter.reset(new FrameLimiter(0));
+	_lastFrameTimer.Reset();
+}
+
+// XSnes3D+: one frame, the same call Run() makes in its loop when run-ahead is off.
+void Emulator::HostRunFrame()
+{
+	_console->RunFrame();
+}
