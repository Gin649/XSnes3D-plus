diff --git a/Core/Shared/Emulator.cpp b/Core/Shared/Emulator.cpp
index 9a7a988..ce25924 100644
--- a/Core/Shared/Emulator.cpp
+++ b/Core/Shared/Emulator.cpp
@@ -212,6 +212,13 @@ void Emulator::HostBegin()
 	_stats.reset(new DebugStats());
 	_frameLimiter.reset(new FrameLimiter(0));
 	_lastFrameTimer.Reset();
+	// Mesen's video decoder and renderer threads turn each picture into the window's image,
+	// which the host never shows: the host reads the PPU's picture. Each frame waited for the
+	// decoder to finish the last one, which on a phone's slow cores made the emulation two to
+	// three times slower. They are stopped, and the decoder is skipped from now on.
+	_hostDriven = true;
+	_videoDecoder->StopThread();
+	_videoRenderer->StopThread();
 }
 
