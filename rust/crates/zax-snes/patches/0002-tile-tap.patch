diff --git a/Core/SNES/SnesTileTap.h b/Core/SNES/SnesTileTap.h
new file mode 100644
index 0000000..b42046a
--- /dev/null
+++ b/Core/SNES/SnesTileTap.h
@@ -0,0 +1,94 @@
+#pragma once
+#include "pch.h"
+#include "SNES/SnesPpuTypes.h"
+
+// XSnes3D+: what the tile tap records while the PPU draws a frame. The host gives the PPU a
+// SnesTapFrame with SnesPpu::SetTileTap and reads SnesTapFrame::Finished after each frame.
+// With no tap set, the PPU records nothing. The structs are read from Rust as raw memory, so
+// their layout must not change without changing rust/crates/zax-snes/src/tap.rs too.
+
+// One drawn piece of a line. Usually a whole line; a game that changes PPU registers in the
+// middle of a line splits it into several pieces, each with the settings in force then.
+struct SnesTapChunk
+{
+	uint16_t Scanline;
+	uint8_t StartX;
+	uint8_t EndX;
+	uint8_t BgMode;
+	uint8_t Bg3Priority;
+	uint8_t MainLayers; // bits 0-3 background layers, bit 4 sprites, as drawn on the main screen
+	uint8_t DirectColor;
+	uint8_t ForcedBlank;
+	uint8_t MosaicSize;
+	uint8_t MosaicEnabled; // bits 0-3, one per background layer
+	uint8_t Padding;
+	uint16_t HScroll[4];
+	uint32_t CgramIndex; // which palette snapshot was in force (SnesTapFrame::Cgram, 256 per snapshot)
+	uint8_t WindowMasked[5][32]; // per layer (4 = sprites), one bit per pixel hidden by a window
+};
+static_assert(sizeof(SnesTapChunk) == 184, "SnesTapChunk layout changed");
+
+// One finished line: the tiles fetched for each background layer (33 columns) and the main
+// screen as drawn, before colour maths and brightness.
+struct SnesTapLine
+{
+	uint16_t Scanline;
+	uint16_t Padding;
+	TileData Tiles[4][33];
+	uint16_t Reference[256];
+};
+static_assert(sizeof(TileData) == 12, "TileData layout changed");
+static_assert(sizeof(SnesTapLine) == 2100, "SnesTapLine layout changed");
+
+// One 8-pixel slice of a sprite, fetched during line FetchScanline and drawn on the next line.
+struct SnesTapSprite
+{
+	uint16_t FetchScanline;
+	int16_t X;
+	uint8_t Palette;
+	uint8_t Priority;
+	uint8_t HorizontalMirror;
+	uint8_t VerticalMirror;
+	uint16_t ChrData[2];
+	uint16_t VramAddress;
+	uint16_t Padding2;
+};
+static_assert(sizeof(SnesTapSprite) == 16, "SnesTapSprite layout changed");
+
+// One frame's worth of records.
+struct SnesTapData
+{
+	vector<SnesTapChunk> Chunks;
+	vector<SnesTapLine> Lines;
+	vector<SnesTapSprite> Sprites;
+	vector<uint16_t> Cgram;
+
+	void Clear()
+	{
+		Chunks.clear();
+		Lines.clear();
+		Sprites.clear();
+		Cgram.clear();
+	}
+};
+
+// The PPU fills Building. When it sends a finished picture (SnesPpu::SendFrame), Building
+// becomes Finished, so Finished always matches the last picture sent, even when the host's
+// frame step ends a little before or after that moment.
+struct SnesTapFrame
+{
+	SnesTapData Building;
+	SnesTapData Finished;
+
+	void FinishFrame()
+	{
+		std::swap(Building, Finished);
+		Building.Clear();
+	}
+
+	void Clear()
+	{
+		Building.Clear();
+		Finished.Clear();
+	}
+};
